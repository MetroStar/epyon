          "STIGUuid": "U_ASD_STIG_V6R4_Manual-xccdf",
          "status": "open",
          "overrides": {},
          "comments": "",
          "finding_details": "The control requires periodic review of audit trails based on system documentation.\n- File: README.md \u2014 No mention of audit log review schedule or process\n- File: etc/atlas/config.yaml \u2014 No configuration for audit log review or review tracking\n- No documentation or code describing audit log review frequency or records\n- Requirement: NOT SATISFIED \u2014 No static evidence of audit log review process or documentation",
          "srg_id": "SRG-APP-000516"
        },
        {
          "uuid": "e108283d-1d59-43c0-bbe1-1d999309e33f",
          "stig_uuid": "U_ASD_STIG_V6R4_Manual-xccdf",
          "target_key": null,
          "stig_ref": null,
          "group_id": "V-222623",
          "rule_id": "SV-222623r961863",
          "rule_id_src": "SV-222623r961863_rule",
          "weight": "10.0",
          "classification": "Unclassified",
          "severity": "medium",
          "rule_version": "APSC-DV-002920",
          "group_title": "The ISSO must report all suspected violations of IA policies in accordance with DoD information system IA procedures.",
          "rule_title": "The ISSO must report all suspected violations of IA policies in accordance with DoD information system IA procedures.",
          "fix_text": "Create and maintain a policy to report IA violations.",
          "false_positives": "",
          "false_negatives": "",
          "discussion": "Violations of IA policies must be reviewed and reported. If there are no policies regarding the reporting of IA violations, IA violations may not be tracked or addressed in a proper manner.",
          "check_content": "Interview the application representative and review the SOPs to ensure that violations of IA policies are analyzed and reported.\n \nIf there is no policy for reporting IA violations, this is a finding.",
          "documentable": "false",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "security_override_guidance": "",
          "ia_controls": "",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
