                <mxCell id="l15_modelcard" value="&lt;b&gt;L15: Model Card Compliance&lt;/b&gt;&#xa;run-modelcard-check.sh&#xa;(skip: quick / stig modes)&#xa;Auto-detects README + model files&#xa;or RUN_MODELCARD=true&#xa;→ modelcard-results.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="ph3_bg" vertex="1">
                    <mxGeometry x="1220" y="36" width="350" height="132" as="geometry"/>
                </mxCell>
                <mxCell id="mode_note" value="Scan mode defaults:  quick → L1 L2 L5 L7 L8 L9 (fast subset)  |  full → all layers  |  nightly → full + Garak, skip L13  |  stig → L13 only  |  huggingface / baseline → full  |  local_model → L14 + L15 only" style="text;html=1;strokeColor=#BBBBBB;fillColor=#FFFFDD;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;rounded=1;" parent="ph3_bg" vertex="1">
                    <mxGeometry x="10" y="180" width="1560" height="28" as="geometry"/>
