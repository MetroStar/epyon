                <mxCell id="l12_garak" value="&lt;b&gt;L12: LLM Security — Garak&lt;/b&gt;&#xa;(opt-in: RUN_GARAK=true)&#xa;(always skip: quick / stig modes)&#xa;Probes: promptinject · dan&#xa;knownbadsignatures · encoding&#xa;→ garak/garak-results.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="ph3_bg" vertex="1">
