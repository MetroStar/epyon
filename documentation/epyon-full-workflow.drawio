                <mxCell id="sync_bar" value="Await all parallel layers complete  (wait for all background PIDs — replay logs in order)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#888888;fontSize=11;fontStyle=3;" parent="1" vertex="1">
