# Copy to .env.local (and .env for docker compose) for local development.
# Never commit .env or .env.local. ./start-epyon loads .env.local and
# restricts it to mode 600. Keep .env and .env.local identical.

# Local Ollama configuration. The Docker endpoint is used only by docker compose.
export OPENAI_BASE_URL=http://localhost:11434/v1
export OPENAI_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
export OPENAI_MODEL=llama3.1:8b

# Integration credentials (local only; these files are gitignored and mode 600).
export JIRA_BASE_URL=https://your-org.atlassian.net
export JIRA_USER_EMAIL=security@example.com
export JIRA_API_TOKEN=
export GH_PAT=
export OPENAI_API_KEY=
export NVD_API_KEY=

# Private ECR login for the web container (refreshed every ECR_REFRESH_HOURS).
# Leave ECR_REGISTRY empty if you do not pull from a private ECR registry.
export ECR_REGISTRY=
export ECR_REGION=
export AWS_PROFILE=
export ECR_REFRESH_HOURS=6

# "Run New Scan" -> "Upload .zip" limits. Defaults (500MB / 2048MB) are
# conservative decompression-bomb/DoS guards; raise them here if you need to
# upload larger projects.
export EPYON_MAX_UPLOAD_MB=500
export EPYON_MAX_UPLOAD_UNZIPPED_MB=2048
