            "CCI-000172"
          ],
          "group_tree": [
            {
              "id": "V-261939",
              "title": "SRG-APP-000492-DB-000333",
              "description": "<GroupDescription></GroupDescription>"
            }
          ],
          "createdAt": "2026-04-30T00:00:00.000Z",
          "updatedAt": "2026-04-30T00:00:00.000Z",
          "STIGUuid": "U_CD_Postgres_16_STIG_V1R2_Manual-xccdf",
          "status": "open",
          "overrides": {},
          "comments": "",
          "finding_details": "Control requires PostgreSQL to log unsuccessful attempts to access security objects (denials/errors) via audit logs.\n- File: pointcloud-project/docker-compose.yml \u2014 PostgreSQL service is present, but no log configuration or pgaudit settings are shown.\n- File: deploy/aws/iris-stack.yaml \u2014 RDS instance is provisioned, but no evidence of log settings or pgaudit configuration.\n- No postgresql.conf, pgaudit.log, or log_directory/logging configuration found in any static artifact.\n- Requirement: PARTIALLY SATISFIED \u2014 PostgreSQL is deployed, but static evidence of audit logging for unsuccessful access attempts is missing.",
          "srg_id": "SRG-APP-000492-DB-000333"
        },
        {
          "uuid": "8c580abd-9057-47c9-939d-8ad4599a4cef",
          "stig_uuid": "U_CD_Postgres_16_STIG_V1R2_Manual-xccdf",
          "target_key": null,
          "stig_ref": null,
          "group_id": "V-261940",
          "rule_id": "SV-261940r1000825",
          "rule_id_src": "SV-261940r1000825_rule",
          "weight": "10.0",
          "classification": "Unclassified",
          "severity": "medium",
          "rule_version": "CD16-00-009600",
          "group_title": "PostgreSQL must generate audit records when categories of information (e.g., classification levels/security levels) are accessed.",
          "rule_title": "PostgreSQL must generate audit records when categories of information (e.g., classification levels/security levels) are accessed.",
          "fix_text": "Note: The following instructions use the PGDATA and PGVER environment variables. Refer to APPENDIX-F for instructions on configuring PGDATA and APPENDIX-H for PGVER. \n\nThe DBMS (PostgreSQL) can be configured to audit these requests using pgaudit. Refer to supplementary content APPENDIX-B for documentation on installing pgaudit. \n\nWith pgaudit installed the following configurations can be made:\n\n$ sudo su - postgres  \n\n$ vi ${PGDATA?}/postgresql.conf  \n\nAdd the following parameters (or edit existing parameters):  \n\npgaudit.log = 'ddl, write, role'  \n\nAs the system administrator, reload the server with the new configuration:  \n\n$ sudo systemctl reload postgresql- ${PGVER?}",
          "false_positives": "",
          "false_negatives": "",
          "discussion": "Changes in categories of information must be tracked. Without an audit trail, unauthorized access to protected data could go undetected.\n\nFor detailed information on categorizing information, refer to FIPS Publication 199, Standards for Security Categorization of federal information and information systems, and FIPS Publication 200, Minimum Security Requirements for federal information and information systems.",
          "check_content": "As the database administrator (shown here as \"postgres\"), run the following SQL:\n\n$ sudo su - postgres\n$ psql -c \"SHOW pgaudit.log\"\n\nIf pgaudit.log does not contain, \"ddl, write, role\", this is a finding.",
          "documentable": "false",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "security_override_guidance": "",
          "ia_controls": "",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "legacy_ids": [],
          "ccis": [
            "CCI-000172"
          ],
          "group_tree": [
            {
              "id": "V-261940",
              "title": "SRG-APP-000494-DB-000344",
              "description": "<GroupDescription></GroupDescription>"
            }
          ],
          "createdAt": "2026-04-30T00:00:00.000Z",
          "updatedAt": "2026-04-30T00:00:00.000Z",
          "STIGUuid": "U_CD_Postgres_16_STIG_V1R2_Manual-xccdf",
          "status": "open",
          "overrides": {},
          "comments": "",
          "finding_details": "Control requires pgaudit.log to include 'ddl, write, role'.\n- File: pointcloud-project/docker-compose.yml \u2014 PostgreSQL service is present, but no pgaudit.log configuration is shown.\n- File: deploy/aws/iris-stack.yaml \u2014 No evidence of pgaudit.log configuration in RDS or EC2 bootstrap.\n- No postgresql.conf or pgaudit settings found in any static file.\n- Requirement: NOT SATISFIED \u2014 No static evidence of pgaudit.log including 'ddl, write, role'.",
          "srg_id": "SRG-APP-000494-DB-000344"
        },
        {
          "uuid": "662a2e45-2131-4ec1-88e9-0856a75d5090",
          "stig_uuid": "U_CD_Postgres_16_STIG_V1R2_Manual-xccdf",
          "target_key": null,
          "stig_ref": null,
          "group_id": "V-261941",
          "rule_id": "SV-261941r1000828",
          "rule_id_src": "SV-261941r1000828_rule",
          "weight": "10.0",
          "classification": "Unclassified",
          "severity": "medium",
          "rule_version": "CD16-00-009700",
          "group_title": "PostgreSQL must generate audit records when unsuccessful attempts to access categories of information (e.g., classification levels/security levels) occur.",
          "rule_title": "PostgreSQL must generate audit records when unsuccessful attempts to access categories of information (e.g., classification levels/security levels) occur.",
          "fix_text": "Note: The following instructions use the PGDATA and PGVER environment variables. Refer to APPENDIX-F for instructions on configuring PGDATA and APPENDIX-H for PGVER.\n\nConfigure PostgreSQL to produce audit records when unsuccessful attempts to access categories of information occur.\n\nAll denials are logged if logging is enabled. To ensure logging is enabled, see the instructions in the supplementary content APPENDIX-C.\n\nWith pgaudit installed the following configurations can be made:\n\n$ sudo su - postgres\n$ vi ${PGDATA?}/postgresql.conf\n\nAdd the following parameters (or edit existing parameters):\n\npgaudit.log = 'ddl, write, role'\n\nAs the system administrator, reload the server with the new configuration:\n\n$ sudo systemctl reload postgresql-${PGVER?}",
          "false_positives": "",
          "false_negatives": "",
          "discussion": "Changes in categories of information must be tracked. Without an audit trail, unauthorized access to protected data could go undetected.\n\nTo aid in diagnosis, it is necessary to keep track of failed attempts in addition to the successful ones.\n\nFor detailed information on categorizing information, refer to FIPS Publication 199, Standards for Security Categorization of federal information and information systems, and FIPS Publication 200, Minimum Security Requirements for federal information and information systems.",
          "check_content": "As the database administrator (shown here as \"postgres\"), run the following SQL:\n\n$ sudo su - postgres\n$ psql -c \"SHOW pgaudit.log\"\n\nIf pgaudit.log does not contain, \"ddl, write, role\", this is a finding.",
          "documentable": "false",
