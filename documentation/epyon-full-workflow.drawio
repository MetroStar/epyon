                </mxCell>
                <mxCell id="l13_stig" value="&lt;b&gt;L13: STIG Compliance Assessment&lt;/b&gt;&#xa;run-stig-scan.sh → run-stig-assessment.py&#xa;→ OpenAI API (gpt-4o-mini)&#xa;→ parse-stig-cklb.py&#xa;Outputs:  stig-results-{slug}.json&#xa;findings-{app}-{slug}.md  /  .cklb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="ph3_bg" vertex="1">
                    <mxGeometry x="368" y="36" width="492" height="132" as="geometry"/>
                </mxCell>
                <mxCell id="l14_pickle" value="&lt;b&gt;L14: Pickle / Serialization Safety&lt;/b&gt;&#xa;run-picklescan.sh&#xa;(skip: quick / stig modes)&#xa;Auto-detects .pkl .pt .safetensors…&#xa;or RUN_PICKLESCAN=true&#xa;→ picklescan-results.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="ph3_bg" vertex="1">
