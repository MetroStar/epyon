# Copy to .env.local for local development. Never commit .env.local.
# ./start-epyon loads this file and restricts it to mode 600.

export JIRA_API_TOKEN=
export GH_PAT=
export OPENAI_API_KEY=
export NVD_API_KEY=

# Local Ollama configuration. The Docker endpoint is used only by docker compose.
export OPENAI_BASE_URL=http://localhost:11434/v1
export OPENAI_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
export OPENAI_MODEL=llama3.1:8b

# Optional non-secret defaults can also be supplied through the environment.
export JIRA_BASE_URL=https://your-org.atlassian.net
export JIRA_USER_EMAIL=security@example.com